# Homebrew Postgres (default):
DATABASE_URL="postgresql://kaiju:kaiju@localhost:5432/kaiju?schema=public"
# Docker Compose (optional, maps host 5433):
# DATABASE_URL="postgresql://kaiju:kaiju@localhost:5433/kaiju?schema=public"

# Sign-in password. SESSION_SECRET signs the session cookie;
# generate one with: openssl rand -hex 32
APP_PASSWORD="change-me"
SESSION_SECRET="change-me"
